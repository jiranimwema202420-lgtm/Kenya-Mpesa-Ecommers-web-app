generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum PaymentProvider {
  MPESA
  CARD
  BANK_TRANSFER
  CASH_ON_DELIVERY
}

enum InventoryMovementType {
  RESTOCK
  SALE
  ADJUSTMENT
  RESERVED
  RELEASED
  RETURN
  DAMAGE
}

enum ReservationStatus {
  RESERVED
  COMMITTED
  RELEASED
  EXPIRED
}

// ==========================================
// CUSTOMER PROFILES
// Supabase Auth owns the actual user identity.
// Profile.id must equal auth.users.id.
// ==========================================

model Profile {
  id        String   @id @db.Uuid
  email     String?  @unique
  fullName  String?
  phone     String?
  avatarUrl String?
  role      UserRole @default(CUSTOMER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses          Address[]
  cart               Cart?
  orders             Order[]
  inventoryMovements InventoryMovement[] @relation("InventoryActor")

  @@map("profiles")
}

// ==========================================
// CUSTOMER ADDRESSES
// ==========================================

model Address {
  id        String @id @default(uuid()) @db.Uuid
  profileId String @db.Uuid

  label                String?
  recipientName        String
  phone                String
  county               String
  town                 String
  estate               String?
  street               String?
  building             String?
  deliveryInstructions String?
  isDefault            Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("addresses")
}

// ==========================================
// PRODUCT CATEGORIES
// ==========================================

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  parentId String? @db.Uuid

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products ProductCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("categories")
}

// ==========================================
// PRODUCTS
// ==========================================

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  slug        String        @unique
  description String?
  status      ProductStatus @default(DRAFT)
  isFeatured  Boolean       @default(false)

  categories ProductCategory[]
  images     ProductImage[]
  variants   ProductVariant[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([isFeatured])
  @@map("products")
}

// ==========================================
// PRODUCT-CATEGORY RELATIONSHIP
// ==========================================

model ProductCategory {
  productId  String @db.Uuid
  categoryId String @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

// ==========================================
// PRODUCT IMAGES
// Supabase Storage stores the actual image files.
// ==========================================

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  variantId String? @db.Uuid

  storageBucket String  @default("products")
  storagePath   String
  altText       String?
  sortOrder     Int     @default(0)
  isPrimary     Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variant ProductVariant? @relation("VariantImages", fields: [variantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
  @@index([variantId])
  @@map("product_images")
}

// ==========================================
// PRODUCT VARIANTS
// Each variant has its own SKU, price and stock.
// Example: Small Red, Medium Red, Large Blue.
// ==========================================

model ProductVariant {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid

  name       String
  sku        String  @unique
  barcode    String? @unique
  attributes Json?   @db.JsonB

  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  costPrice      Decimal? @db.Decimal(12, 2)

  weightGrams Int?
  isActive    Boolean @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  images       ProductImage[]         @relation("VariantImages")
  inventory    Inventory?
  cartItems    CartItem[]
  orderItems   OrderItem[]
  reservations InventoryReservation[]
  movements    InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([isActive])
  @@map("product_variants")
}

// ==========================================
// INVENTORY
// ==========================================

model Inventory {
  id        String @id @default(uuid()) @db.Uuid
  variantId String @unique @db.Uuid

  quantityOnHand   Int @default(0)
  quantityReserved Int @default(0)
  reorderLevel     Int @default(0)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inventory")
}

// ==========================================
// INVENTORY MOVEMENTS
// ==========================================

model InventoryMovement {
  id        String  @id @default(uuid()) @db.Uuid
  variantId String  @db.Uuid
  actorId   String? @db.Uuid

  type      InventoryMovementType
  quantity  Int
  reference String?
  notes     String?

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  actor Profile? @relation("InventoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([variantId, createdAt])
  @@index([actorId])
  @@map("inventory_movements")
}

// ==========================================
// INVENTORY RESERVATIONS
// ==========================================

model InventoryReservation {
  id        String @id @default(uuid()) @db.Uuid
  orderId   String @db.Uuid
  variantId String @db.Uuid

  quantity  Int
  status    ReservationStatus @default(RESERVED)
  expiresAt DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, variantId])
  @@index([variantId, status])
  @@index([status, expiresAt])
  @@map("inventory_reservations")
}

// ==========================================
// SHOPPING CARTS
// One cart per customer.
// ==========================================

model Cart {
  id        String @id @default(uuid()) @db.Uuid
  profileId String @unique @db.Uuid

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carts")
}

// ==========================================
// SHOPPING CART ITEMS
// ==========================================

model CartItem {
  id        String @id @default(uuid()) @db.Uuid
  cartId    String @db.Uuid
  variantId String @db.Uuid

  quantity Int @default(1)

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

// ==========================================
// CUSTOMER ORDERS
// ==========================================

model Order {
  id          String @id @default(uuid()) @db.Uuid
  orderNumber String @unique
  profileId   String @db.Uuid

  status        OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus PaymentStatus @default(PENDING)

  currency String @default("KES") @db.Char(3)

  subtotal    Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  shippingFee Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  customerName  String?
  customerEmail String?
  customerPhone String?

  shippingAddress Json @db.JsonB

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Restrict)

  items        OrderItem[]
  payments     Payment[]
  reservations InventoryReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@map("orders")
}

// ==========================================
// ORDER ITEMS
// Product details are stored as snapshots.
// ==========================================

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid
  productId String? @db.Uuid
  variantId String? @db.Uuid

  productName String
  variantName String?
  sku         String?

  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

// ==========================================
// PAYMENTS
// Supports M-Pesa and other payment methods.
// ==========================================

model Payment {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid

  provider PaymentProvider
  status   PaymentStatus   @default(PENDING)

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("KES") @db.Char(3)
  phone    String?

  merchantRequestId  String? @unique
  checkoutRequestId  String? @unique
  mpesaReceiptNumber String? @unique

  resultCode        Int?
  resultDescription String?

  rawCallback Json? @db.JsonB

  requestedAt DateTime  @default(now())
  completedAt DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  events PaymentEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId, status])
  @@index([provider, status])
  @@map("payments")
}

// ==========================================
// PAYMENT EVENTS
// Supports callback auditing and idempotency.
// ==========================================

model PaymentEvent {
  id        String @id @default(uuid()) @db.Uuid
  paymentId String @db.Uuid

  eventType       String
  providerEventId String? @unique
  idempotencyKey  String  @unique

  payload Json @db.JsonB

  status          PaymentEventStatus @default(PENDING)
  attemptCount    Int                @default(0)
  receivedAt      DateTime           @default(now())
  lastAttemptAt   DateTime?
  processedAt     DateTime?
  processingError String?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, receivedAt])
  @@index([status, receivedAt])
  @@index([eventType])
  @@map("payment_events")
}
